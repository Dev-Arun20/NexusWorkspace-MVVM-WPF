<Window x:Class="NexusMVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NEXUS - Smart Workspace"
        Height="760"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <Window.Resources>

        <!-- Colors and brushes -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6857E8"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#151A2D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#20263A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8991A5"/>

        <!-- Button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6857E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#5140CB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#ECEBFA"/>
            <Setter Property="Foreground" Value="#6857E8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- Sidebar navigation button -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BED0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#292F48"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#FAFBFD"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F8FC"/>
            <Setter Property="Foreground" Value="#8991A5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">

            <DockPanel Margin="18">

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="8,12,0,35">

                    <StackPanel Orientation="Horizontal">
                        <Border Background="#6857E8"
                                Width="38"
                                Height="38"
                                CornerRadius="10">
                            <TextBlock Text="N"
                                       Foreground="White"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="NEXUS"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="SMART WORKSPACE"
                                       Foreground="#8D95AD"
                                       FontSize="9"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="WORKSPACE"
                               Foreground="#707991"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,0,0,12"/>

                    <Button Content="▦   Overview"
                            Style="{StaticResource NavButton}"
                            Background="#6857E8"
                            Foreground="White"/>

                    <Button Content="☑   My Tasks"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="▤   Activity"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="▦   Calendar"
                            Style="{StaticResource NavButton}"/>

                    <TextBlock Text="PREFERENCES"
                               Foreground="#707991"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,28,0,12"/>

                    <Button Content="⚙   Settings"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="ⓘ   Help Center"
                            Style="{StaticResource NavButton}"/>

                </StackPanel>

                <!-- User profile -->
                <Border DockPanel.Dock="Bottom"
                        Background="#242A40"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,15,0,5">

                    <StackPanel Orientation="Horizontal">
                        <Border Background="#6857E8"
                                Width="36"
                                Height="36"
                                CornerRadius="18">
                            <TextBlock Text="JD"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="John Developer"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                            <TextBlock Text="Administrator"
                                       Foreground="#9BA3BA"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->

        <Grid Grid.Column="1" Margin="30,25,30,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Good afternoon, John 👋"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="Here's what's happening in your workspace today."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBox Width="180"
                             Height="36"
                             Padding="10"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search tasks"/>

                    <Button Content="＋ New Task"
                            Style="{StaticResource PrimaryButton}"
                            Margin="12,0,0,0"
                            Command="{Binding AddTaskCommand}"/>

                </StackPanel>
            </Grid>

            <!-- Statistics cards -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,22">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL TASKS"
                                   Foreground="#8991A5"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalTasks}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#20263A"
                                   Margin="0,12,0,5"/>
                        <TextBlock Text="All assigned tasks"
                                   Foreground="#8991A5"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="COMPLETED"
                                   Foreground="#8991A5"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CompletedTasks}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#20B486"
                                   Margin="0,12,0,5"/>
                        <TextBlock Text="Successfully finished"
                                   Foreground="#8991A5"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PENDING"
                                   Foreground="#8991A5"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingTasks}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#E9A23B"
                                   Margin="0,12,0,5"/>
                        <TextBlock Text="Tasks in progress"
                                   Foreground="#8991A5"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="PROGRESS"
                                   Foreground="#8991A5"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#6857E8"
                                   Margin="0,12,0,5"/>
                        <ProgressBar Value="{Binding ProgressPercentage}"
                                     Maximum="100"
                                     Height="6"
                                     Foreground="#6857E8"
                                     Background="#EAE8FA"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Task toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="My Tasks"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Manage your daily activities"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="All"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowAllCommand}"
                            Margin="0,0,6,0"/>

                    <Button Content="Active"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowActiveCommand}"
                            Margin="0,0,6,0"/>

                    <Button Content="Completed"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowCompletedCommand}"
                            Margin="0,0,6,0"/>

                    <Button Content="↻ Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>

                </StackPanel>
            </Grid>

            <!-- Task table -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12"
                    Padding="12">

                <DataGrid ItemsSource="{Binding FilteredTasks}"
                          SelectedItem="{Binding SelectedTask}"
                          IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="TASK NAME"
                                            Binding="{Binding Title}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="DESCRIPTION"
                                            Binding="{Binding Description}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="PRIORITY"
                                            Binding="{Binding Priority}"
                                            Width="*"/>

                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding Status}"
                                            Width="*"/>

                        <DataGridTextColumn Header="DUE DATE"
                                            Binding="{Binding DueDate}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>
            </Border>

            <!-- Bottom action buttons -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="NEXUS WORKSPACE  |  Version 1.0"
                           Foreground="#8991A5"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="✓ Complete"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CompleteTaskCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Delete"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DeleteTaskCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="Export CSV"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCommand}"/>

                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
